{
  "name": "berry-safety-sigma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/berry-safety-sigma/ --outDir dist-pages",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "vite preview --host 0.0.0.0 --base=/berry-safety-sigma/ --outDir dist-pages",
    "test": "playwright test",
    "dev:api": "node --env-file-if-exists=server/.env server/index.mjs",
    "start:api": "node server/index.mjs",
    "test:api": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
