# Non-secret URL of the authenticated directory of administrator-enabled accounts.
# Set before starting Vite or building the site. Never put an API token here.
# Leave empty to use the local demo account directory.
VITE_DIRECTORY_URL=

# Public demo account configuration (these are not authentication secrets).
VITE_DEMO_ADMIN_EMAIL=bryx.96@gmail.com
VITE_DEMO_ADMIN_NAME=Bryan
VITE_DEMO_INSPECTOR_EMAIL=bcespedes@hortifrut.com
VITE_DEMO_INSPECTOR_NAME=Bryan

# Public URL of the Berry server endpoint, never the Make webhook URL.
# Example: https://your-api.example/api/integrations/make/test
# Empty on GitHub Pages keeps the test disconnected.
VITE_MAKE_TEST_API_URL=

# Optional public overrides; the project defaults are in src/supabase-project.ts.
# Only a Publishable key belongs in the browser configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
