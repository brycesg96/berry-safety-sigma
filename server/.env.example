# Server-only secrets. Never use a VITE_ prefix and never commit real values.
MAKE_WEBHOOK_URL=
MAKE_TEST_API_TOKEN=
# Disabled unless explicitly enabled; fixed fictional payload only.
MAKE_TEST_ENABLED=false
# Enable only after mapping dynamic To/CC and the Excel attachment in Make.
MAKE_REPORTS_ENABLED=false
# Global presentation prototype: no per-browser authorization. Set false to require authentication.
BERRY_PROTOTYPE_MODE=true
# Local journal survives process restarts, not replacement of the Render free filesystem.
REPORT_REGISTRY_PATH=/tmp/berry-report-receipts.sqlite
# Exact browser origins, without a path or trailing slash.
BERRY_ALLOWED_ORIGINS=https://brycesg96.github.io
PORT=8787
NODE_ENV=production
# In the managed cloud environment, retain proxy/CA settings.
# NODE_USE_ENV_PROXY=1
